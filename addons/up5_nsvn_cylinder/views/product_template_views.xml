<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Cylinder tab to product form -->
    <record id="up5_nsvn_cylinder_product_tmpl_form" model="ir.ui.view">
        <field name="name">up5_nsvn_cylinder.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cylinder" name="cylinder_page">
                    <group>
                        <field name="is_cylinder"/>
                        <field name="gas_type" invisible="not is_cylinder"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
